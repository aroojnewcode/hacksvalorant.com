---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { pageTitle } from '../../../config/seo';
import { getPageSeoEntry, productPageH1 } from '../../../config/pageSeo';
import { breadcrumbSchema, organizationSchema, productSchema } from '../../../utils/schema';
import { imageSizeForSrc } from '../../../config/siteImages';
import ProductDetail from '../../../components/ProductDetail.astro';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(`Buy ${product.title}`);
const metaDescription =
  seoEntry?.description ??
  `Buy ${product.title} Valorant hacks — ${product.desc}`;
const pageH1 = productPageH1(pagePath, product.title);
const productImageSize = imageSizeForSrc(product.images[0]?.src ?? '');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={product.images[0]?.src}
  ogImageAlt={product.images[0]?.alt ?? product.title}
  ogImageWidth={productImageSize.width}
  ogImageHeight={productImageSize.height}
  jsonLd={[
    organizationSchema(),
    productSchema({
      name: pageH1,
      description: metaDescription,
      url: pagePath,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} pageH1={pageH1} />
</BaseLayout>
