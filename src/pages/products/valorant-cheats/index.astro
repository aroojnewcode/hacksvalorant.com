---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import { productPath } from '../../../utils/path';

const seo = resolvePageSeo('/products/valorant-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const tierProducts = productPages.filter((product) => product.kind === 'tier');
const utilityProducts = productPages.filter((product) => product.kind === 'utility');

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --products-valorant-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --products-valorant-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --products-valorant-rbp: desktop;
      }
    }
  </style>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold normal-case md:text-4xl">{seo.h1}</h1>
        <p class="text-lg text-muted-foreground">
          Buy Valorant PC hacks at hacksvalorant.com — Lite, Pro and Elite tiers with aim assist &amp; wall ESP, HWID
          spoofer, UGC recovery and skin preview tools. Instant delivery after checkout.
        </p>
      </div>

      <section class="mt-10" aria-labelledby="valorant-tier-products-heading">
        <h2 id="valorant-tier-products-heading" class="text-xl font-semibold">Lite, Pro and Elite hack tiers</h2>
        <div class="mt-6 grid min-w-0 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3 [&>*]:min-w-0">
          {tierProducts.map((product) => (
            <CatalogCard
              label={cardLabel(product)}
              title={product.title}
              href={productPath(product.slug)}
              buyUrl={product.buyUrl}
              features={product.features}
              more={product.more}
              icon={cardIcon(product)}
              badge={product.badge}
              variant={product.variant}
              buyLabel={`Buy ${product.slug} tier now`}
              viewLabel={`Open ${product.slug} tier page`}
            />
          ))}
        </div>
      </section>

      <section class="mt-12" aria-labelledby="valorant-utility-products-heading">
        <h2 id="valorant-utility-products-heading" class="text-xl font-semibold">HWID spoofer, UGC and cosmetic utilities</h2>
        <div class="mt-6 grid min-w-0 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3 [&>*]:min-w-0">
          {utilityProducts.map((product) => (
            <CatalogCard
              label={cardLabel(product)}
              title={product.title}
              href={productPath(product.slug)}
              buyUrl={product.buyUrl}
              features={product.features}
              more={product.more}
              icon={cardIcon(product)}
              badge={product.badge}
              variant={product.variant}
              buyLabel={`Buy ${product.slug} utility now`}
              viewLabel={`Open ${product.slug} utility page`}
            />
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
