---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getBlogTags,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const tags = getBlogTags();
const lcpImage = webpSrc(featured?.image ?? blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);

const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --blog-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --blog-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --blog-rbp: desktop;
      }
    }
  </style>

  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <section
    class="border-y border-border bg-muted/20 py-12 md:py-16"
    aria-labelledby="blog-latest-title"
    data-index-list
    data-empty-message={t.blog.emptyFilter}
  >
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">Valorant articles</p>
        <h1 id="blog-latest-title" class="section-header__title">{seo.h1 ?? t.blog.latestTitle}</h1>
        <p class="section-header__subtitle">
          Filter posts for Valorant guides on aimbot, ESP, minimap radar, and Vanguard patch-day checklists.
        </p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
          data-index-filters
        >
          <button
            type="button"
            class="article-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-index-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="article-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-index-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect id="index-sort-select" />
      </div>

      {
        featured && (
          <div id="blog-featured" class="mt-10" data-index-featured aria-labelledby="blog-featured-heading">
            <h2 id="blog-featured-heading" class="text-xl font-semibold text-foreground">Featured article</h2>
            <BlogCard
              post={featured}
              index={0}
              eager
              showDate
              layout="featured"
              indexCard
              readCtaLabel={`Featured read — ${featured.slug}`}
            />
          </div>
        )
      }

      <h2 id="blog-grid-heading" class="mt-10 text-xl font-semibold text-foreground">All articles by topic</h2>
      <div
        id="blog-grid"
        class="mt-6 grid min-w-0 gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10 [&>*]:min-w-0"
        aria-labelledby="blog-grid-heading"
      >
        {gridPosts.map((post, index) => (
          <BlogCard
            post={post}
            index={index}
            showDate
            indexCard
            readCtaLabel={`Read article — ${post.slug}`}
          />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Return to homepage
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { setupBlogIndexFilters } from '../../scripts/blog-index.ts';
    setupBlogIndexFilters();
  </script>
</BaseLayout>
