---
import CheckoutBridgeLayout from '../../../layouts/CheckoutBridgeLayout.astro';
import {
  ZADEYO_VALORANT_CHECKOUT_URL,
  ZADEYO_VALORANT_PRODUCT_SEO,
} from '../../../config/zadeyoValorantProductSeo';
import { PRIMARY_CHEAT_IMAGE } from '../../../config/siteImages';
import { Button } from '@/components/starwind/button';

const seo = ZADEYO_VALORANT_PRODUCT_SEO;
const capsuleAlt = 'Valorant — competitive tactical shooter artwork';
const headingFor = (key: (typeof seo.bodySections)[number]['headingKey']) => seo[key];
---

<CheckoutBridgeLayout
  title={seo.title}
  description={seo.description}
  logoAlt={seo.logoAlt}
  ogImage={PRIMARY_CHEAT_IMAGE}
  ogImageAlt="Valorant PC ranked match — Valorant Hacks checkout preview"
>
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --zadeyo-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --zadeyo-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --zadeyo-rbp: desktop;
      }
    }
  </style>
  <article>
    <header class="space-y-4 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">ZADEYO · PC multiplayer</p>
      <h1 class="text-3xl font-bold leading-tight md:text-4xl">{seo.h1}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{seo.intro}</p>
      <Button as="a" href={ZADEYO_VALORANT_CHECKOUT_URL} variant="primary" size="lg" class="mt-2">
        Open ZADEYO secure checkout
      </Button>
    </header>

    <figure class="mt-8 overflow-hidden rounded-xl border border-border">
      <img
        src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/359550/5878a9291aaf2334e08424c6db8e9635d9fa05b4/library_capsule_2x.jpg"
        alt={capsuleAlt}
        width="920"
        height="430"
        loading="lazy"
        class="h-auto w-full"
      />
    </figure>

    <section class="mt-10 space-y-4" aria-labelledby="product-details-title">
      <h2 id="product-details-title" class="text-xl font-semibold">{seo.h2ProductDetails}</h2>
      <p class="text-muted-foreground">
        Compare modules on{' '}
        <a href="/products/valorant-cheats/" class="text-primary hover:underline">hacksvalorant.com product catalog</a>
        before you continue. Checkout and license delivery run on ZADEYO with secure payment and instant digital access.
      </p>
    </section>

    <section class="mt-8 space-y-4" aria-labelledby="features-title">
      <h2 id="features-title" class="text-xl font-semibold">{seo.h2Features}</h2>
      {seo.sections.map((section) => (
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">{section.heading}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      ))}
      <ul class="list-disc space-y-2 pl-5 text-muted-foreground">
        <li>Configurable aimbot FOV, smoothness, and hitbox selection.</li>
        <li>Player ESP, skeleton types, snaplines, and ability ESP callouts.</li>
        <li>Save and load config profiles for competitive and unrated playlists.</li>
      </ul>
    </section>

    <section class="mt-8 space-y-3" aria-labelledby="system-requirements-title">
      <h2 id="system-requirements-title" class="text-xl font-semibold">{seo.h2SystemRequirements}</h2>
      <p class="text-muted-foreground">
        Windows 10 and 11 supported. HVCI ON, Core Isolation ON, TPM ON, Secure Boot ON. Cloud DMA is required for full functionality on supported builds.
      </p>
    </section>

    {
      seo.bodySections.map((block) => (
        <section class="mt-8 space-y-3" aria-labelledby={`go-valorant-${block.id}`}>
          <h2 id={`go-valorant-${block.id}`} class="text-xl font-semibold">
            {headingFor(block.headingKey)}
          </h2>
          {block.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </section>
      ))
    }

    <section class="mt-8 space-y-3" aria-labelledby="checkout-help-title">
      <h2 id="checkout-help-title" class="text-lg font-semibold">Before you buy</h2>
      <p class="text-muted-foreground">
        Read the{' '}
        <a href="/faq/" class="text-primary hover:underline">FAQ on loader setup and Vanguard checks</a>
        or open the{' '}
        <a href="/support/" class="text-primary hover:underline">support desk for checkout help</a>.
      </p>
    </section>
  </article>
</CheckoutBridgeLayout>
