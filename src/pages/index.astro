---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { webpSrc } from '../utils/responsiveImage';
import { PRIMARY_CHEAT_IMAGE } from '../config/siteImages';
const seo = resolvePageSeo('/');

const heroLcpImage = webpSrc(PRIMARY_CHEAT_IMAGE, 512);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema()]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection titleBrand={seo.h1} titleAccent="" />
  <FeaturesSection />
  <ProductsSection maxProducts={6} useCarousel={false} uniqueCardAnchors />
  <ContentSections blogPostCount={3} showWorkflow={false} showFaq={false} uniqueBlogAnchors />
</BaseLayout>
