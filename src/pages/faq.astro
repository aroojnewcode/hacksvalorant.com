---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --faq-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --faq-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --faq-rbp: desktop;
      }
    }
  </style>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="section-header section-header--wide mt-6">
        <p class="section-header__eyebrow">Help center</p>
        <h1 id="faq-page-title" class="section-header__title">
          {seo.h1 ?? 'Valorant hacks FAQ — tiers, Vanguard, loader and checkout'}
        </h1>
        <p class="section-header__subtitle">
          Valorant tiers, bans, setup and Vanguard loader help—Lite, Pro, Elite utilities, safety and checkout in one place.
        </p>
      </header>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" hideHeader titleId="faq-page-title" />
</BaseLayout>
