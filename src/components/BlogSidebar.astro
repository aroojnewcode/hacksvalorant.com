---
import '../styles/blog-sidebar.css';
import Icon from './icons/Icon.astro';
import { blogPostPath, productPath, ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { t } from '../i18n';
import type { BlogPostFull } from '../data/blog';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';

interface Props {
  post: BlogPostFull;
  related: BlogPostFull[];
  class?: string;
}

const { post, related, class: className } = Astro.props;

const tocCount = post.body.filter((b) => b.type === 'h2').length;

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const toc = post.body
  .filter((block) => block.type === 'h2' || block.type === 'h3')
  .map((block) => ({
    level: block.type as 'h2' | 'h3',
    text: 'text' in block ? block.text : '',
    id: slugify('text' in block ? block.text : ''),
  }));

const defaultProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Valorant hack products', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Elite hacks', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'Skin preview tools', href: productPath('unlock-all'), icon: 'sidebarSkin' },
  { label: 'HWID Spoofer', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
  { label: 'UGC', href: productPath('ugc'), icon: 'sidebarUgc' },
];

const verifyGuideProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Valorant catalog (verify guide)', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Elite tier (verify guide)', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'Skin preview pack', href: productPath('unlock-all'), icon: 'sidebarSkin' },
  { label: 'HWID spoofer utility', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
  { label: 'UGC appeal workspace', href: productPath('ugc'), icon: 'sidebarUgc' },
];

const streamProofProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Valorant shop (stream)', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Elite capture tools (stream)', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'Skin preview (stream)', href: productPath('unlock-all'), icon: 'sidebarSkin' },
  { label: 'HWID spoofer (stream setup)', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
  { label: 'UGC appeals (stream)', href: productPath('ugc'), icon: 'sidebarUgc' },
];

const practiceRangeProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Practice hub — Valorant products', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Elite tier (post-drill ranked)', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'Skin preview (practice)', href: productPath('unlock-all'), icon: 'sidebarSkin' },
  { label: 'HWID spoofer (practice)', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
  { label: 'UGC workspace (practice)', href: productPath('ugc'), icon: 'sidebarUgc' },
];

const radarGuideProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Valorant shop (radar)', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Elite tier (radar + aimbot)', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'Skin preview (radar)', href: productPath('unlock-all'), icon: 'sidebarSkin' },
  { label: 'HWID spoofer (radar)', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
  { label: 'UGC appeals (radar)', href: productPath('ugc'), icon: 'sidebarUgc' },
];

const buyGuideProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Compare all Valorant hack tiers', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Lite ESP product page', href: productPath('lite'), icon: 'sidebarElite' },
  { label: 'Pro aimbot product page', href: productPath('pro'), icon: 'sidebarElite' },
  { label: 'Elite automation product page', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'HWID spoofer add-on', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
];

const patchGuideProductLinks: { label: string; href: string; icon: IconName }[] = [
  { label: 'Live status — Valorant product hub', href: ROUTES.products, icon: 'sidebarHub' },
  { label: 'Reload Lite ESP after updates', href: productPath('lite'), icon: 'sidebarElite' },
  { label: 'Reload Pro aimbot after updates', href: productPath('pro'), icon: 'sidebarElite' },
  { label: 'Elite tier patch-day presets', href: ROUTES.productsElite, icon: 'sidebarElite' },
  { label: 'HWID spoofer if verify fails', href: productPath('hwid-spoofer'), icon: 'sidebarHwid' },
];

const productLinks =
  post.slug === 'vanguard-verify-fix'
    ? verifyGuideProductLinks
    : post.slug === 'valorant-stream-proof'
      ? streamProofProductLinks
      : post.slug === 'valorant-range-practice'
        ? practiceRangeProductLinks
        : post.slug === 'valorant-minimap-radar'
          ? radarGuideProductLinks
          : post.slug === 'buy-valorant-hacks'
            ? buyGuideProductLinks
            : post.slug === 'vanguard-patch-checklist'
              ? patchGuideProductLinks
              : defaultProductLinks;
---

<aside
  class:list={[
    'blog-sidebar min-w-0 lg:sticky lg:top-[calc(var(--floating-nav-clearance)+0.5rem)] lg:max-h-[calc(100vh-var(--floating-nav-clearance)-1rem)] lg:self-start lg:overflow-y-auto lg:overflow-x-hidden lg:pr-0.5',
    className,
  ]}
  aria-label="Article sidebar"
>
  {
    toc.length > 0 && (
      <section class="blog-sidebar__block" aria-labelledby="blog-sidebar-toc-title">
        <h2 id="blog-sidebar-toc-title" class="blog-sidebar__heading">
          <Icon name="layers" size={14} class="text-primary" aria-hidden="true" />
          <span class="blog-sidebar__heading-text">In this article</span>
          {tocCount > 0 && (
            <Badge variant="secondary" size="sm" class="h-5 shrink-0 rounded-full px-1.5 tabular-nums text-[10px]">
              {tocCount}
            </Badge>
          )}
        </h2>
        <nav aria-label="Table of contents">
          <ul class="blog-sidebar__toc-list" data-blog-toc>
            {toc.map((item) => (
              <li class:list={[item.level === 'h3' && 'blog-sidebar__toc-item--nested']}>
                <button
                  type="button"
                  class="blog-sidebar__toc-link blog-toc-link truncate"
                  data-toc-target={item.id}
                  title={item.text}
                >
                  {item.text}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="blog-sidebar__block" aria-labelledby="blog-sidebar-related-title">
        <h2 id="blog-sidebar-related-title" class="blog-sidebar__heading">
          <Icon name="navBlog" size={14} class="text-primary" aria-hidden="true" />
          Related guides
        </h2>
        <ul class="blog-sidebar__list">
          {related.map((item) => (
            <li>
              <a href={blogPostPath(item.slug)} class="blog-sidebar__link" title={item.title}>
                <Icon name="arrowUpRight" size={13} class="shrink-0 opacity-70" aria-hidden="true" />
                <span class="blog-sidebar__truncate">{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="blog-sidebar__block blog-sidebar__block--shop" aria-labelledby="blog-sidebar-products-title">
    <h2 id="blog-sidebar-products-title" class="blog-sidebar__heading">
      <Icon name="navProducts" size={14} class="text-primary" aria-hidden="true" />
      Our products
    </h2>
    <ul class="blog-sidebar__list">
      {productLinks.map((link) => (
        <li>
          <a href={link.href} class="blog-sidebar__link" title={link.label}>
            <Icon name={link.icon} size={13} class="shrink-0 text-primary" aria-hidden="true" />
            <span class="blog-sidebar__truncate">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <Button
      as="a"
      href={checkoutPath('valorant')}
      variant="primary"
      size="sm"
      class="blog-sidebar__cta mt-2.5 w-full min-w-0 justify-start"
      aria-label={t.ui.checkoutAria}
    >
      <span class="truncate">
        {
          post.slug === 'vanguard-verify-fix'
            ? 'Start Valorant checkout'
            : post.slug === 'valorant-stream-proof'
              ? 'Checkout stream-proof tier'
              : post.slug === 'valorant-range-practice'
                ? 'Checkout after range drills'
                : post.slug === 'valorant-minimap-radar'
                  ? 'Checkout Lite radar tier'
                  : post.slug === 'buy-valorant-hacks'
                    ? 'Open secure checkout (buy guide)'
                    : post.slug === 'vanguard-patch-checklist'
                      ? 'Checkout after status is green'
                      : 'Buy Valorant Hacks'
        }
      </span>
      <Icon name="arrowRight" size={16} class="shrink-0" />
    </Button>
  </section>
</aside>

<script>
  (() => {
    const tocRoot = document.querySelector('[data-blog-toc]');
    if (!tocRoot) return;
    const links = [...tocRoot.querySelectorAll('.blog-toc-link')];
    const headings = links
      .map((link) => document.getElementById(link.getAttribute('data-toc-target')))
      .filter((el) => el instanceof HTMLElement);
    if (headings.length === 0) return;

    const setActive = () => {
      const scrollPos = window.scrollY + 120;
      let current = headings[0];
      for (const h of headings) {
        if (h.offsetTop <= scrollPos) current = h;
      }
      links.forEach((link) => {
        const id = link.getAttribute('data-toc-target');
        link.classList.toggle('is-active', id === current.id);
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-toc-target');
        const target = id ? document.getElementById(id) : null;
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        }
      });
    });

    window.addEventListener('scroll', setActive, { passive: true });
    setActive();
  })();
</script>
